NODE_ENV=development
PORT=3002

# Database. Prefer DB_CONNECTION_STRING for deployments.
DB_CONNECTION_STRING=Server=your-sql-server;Database=MappedIn3DModels;User Id=your-user;Password=your-password;Encrypt=true;TrustServerCertificate=false;
# DB_SERVER=
# DB_NAME=MappedIn3DModels
# DB_USER=
# DB_PASSWORD=
# DB_ENCRYPT=true
# DB_TRUST_SERVER_CERTIFICATE=false

# Single-admin login. Generate ADMIN_PASSWORD_HASH with backend/auth createScryptPasswordHash.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=scrypt$16384$8$1$replace-with-salt$replace-with-hash
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002
